mergeInto(LibraryManager.library,{ApartmentBatchReady:function(count){document.documentElement.dataset.batched=count;},ApartmentLightAudit:function(json){window.apartmentLightAudit=JSON.parse(UTF8ToString(json));window.dispatchEvent(new CustomEvent("apartment-light-audit",{detail:window.apartmentLightAudit}));},ApartmentFixtureList:function(json){window.apartmentFixtureLabels=JSON.parse(UTF8ToString(json)).labels;window.dispatchEvent(new CustomEvent("apartment-fixtures",{detail:window.apartmentFixtureLabels}));},ApartmentFixtureSelected:function(index){window.dispatchEvent(new CustomEvent("apartment-fixture-selected",{detail:index}));},ApartmentReady:function(renderer){document.documentElement.dataset.renderer=UTF8ToString(renderer);},ApartmentStep:function(){window.dispatchEvent(new CustomEvent('apartment-step'));},ApartmentReport:function(fps,x,z,yaw){window.dispatchEvent(new CustomEvent('apartment-frame',{detail:{fps:fps,x:x,z:z,yaw:yaw}}));}});
